# Backend de datos: "mock" (datos ficticios en el navegador) o "supabase"
VITE_DATA_BACKEND=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Proveedor de pagos: "simulado" o "stripe" (requiere la Edge Function create-checkout)
VITE_PAYMENT_PROVIDER=simulado

# URL pública que se codifica en los QR de mesa
VITE_PUBLIC_BASE_URL=https://turestaurante.app
