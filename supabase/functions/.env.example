# Variables de la Edge Function «invitations» para pruebas LOCALES.
# Copia este archivo a supabase/functions/.env.local (ignorado por git).
# NO pongas aquí claves: SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY las da Supabase
# a la función automáticamente (también `supabase functions serve` en local).
APP_URL=http://localhost:5173/
ALLOWED_ORIGINS=http://localhost:5173
MIN_RESPONSE_MS=1500
